<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HunterModManager.Core\HunterModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Resource Include="Assets\daimao.ico" />
    <Resource Include="Assets\portraits\*.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbedSevenZip)' == 'true'">
    <EmbeddedResource Include="..\..\artifacts\tools\7zip\7z.exe" LogicalName="HunterModManager.Tools.7z.exe" />
    <EmbeddedResource Include="..\..\artifacts\tools\7zip\7z.dll" LogicalName="HunterModManager.Tools.7z.dll" />
    <EmbeddedResource Include="..\..\artifacts\tools\7zip\License.txt" LogicalName="HunterModManager.Tools.License.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="HunterModManager.Tools.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>HunterModManager.Wpf.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\daimao.ico</ApplicationIcon>
    <Title>呆猫mod manager</Title>
    <Product>呆猫mod manager</Product>
    <Description>怪物猎人 Mod 管理工具</Description>
    <Version>0.1.2</Version>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
