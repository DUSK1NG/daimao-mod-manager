<Window x:Class="HunterModManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HunterModManager.Wpf.ViewModels"
        xmlns:conv="clr-namespace:HunterModManager.Wpf.Converters"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="呆猫mod manager" Icon="/HunterModManager.Wpf;component/Assets/daimao.ico" Width="1100" Height="760" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragEnter="Window_DragEnter"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyVis" />
        <conv:InverseNullOrEmptyToVisibilityConverter x:Key="InvNotEmptyVis" />
        <!-- 68 DIP portraits at up to 300% display scaling. Keep full-size artwork in Assets. -->
        <BitmapImage x:Key="StickerPortrait" UriSource="/HunterModManager.Wpf;component/Assets/portraits/daimao-sticker.png"
                     DecodePixelWidth="204" CacheOption="OnLoad" po:Freeze="True" />
        <BitmapImage x:Key="CrayonPortrait" UriSource="/HunterModManager.Wpf;component/Assets/portraits/daimao-crayon.png"
                     DecodePixelWidth="204" CacheOption="OnLoad" po:Freeze="True" />
        <BitmapImage x:Key="PixelPortrait" UriSource="/HunterModManager.Wpf;component/Assets/portraits/daimao-pixel.png"
                     DecodePixelWidth="204" CacheOption="OnLoad" po:Freeze="True" />
    </Window.Resources>

    <Grid Background="{StaticResource BgDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/HunterModManager.Wpf;component/Assets/daimao.ico" Width="38" Height="38" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DAIMAO MOD MANAGER" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="呆猫mod manager" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BgDeepBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource GameToggle}" Content="世界" ToolTip="怪物猎人：世界"
                                      IsChecked="{Binding IsWorldSelected, Mode=OneWay}"
                                      Command="{Binding SelectGameCommand}"
                                      CommandParameter="{x:Static vm:MainViewModel+GameIdValues.World}" />
                        <ToggleButton Style="{StaticResource GameToggle}" Content="崛起" ToolTip="怪物猎人：崛起"
                                      IsChecked="{Binding IsRiseSelected, Mode=OneWay}"
                                      Command="{Binding SelectGameCommand}"
                                      CommandParameter="{x:Static vm:MainViewModel+GameIdValues.Rise}" />
                        <ToggleButton Style="{StaticResource GameToggle}" Content="荒野" ToolTip="怪物猎人：荒野"
                                      IsChecked="{Binding IsWildsSelected, Mode=OneWay}"
                                      Command="{Binding SelectGameCommand}"
                                      CommandParameter="{x:Static vm:MainViewModel+GameIdValues.Wilds}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,11,20,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="当前游戏目录" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding GameRoot, Mode=OneWay}" IsReadOnly="True"
                             ToolTip="{Binding GameRoot}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="更改目录" Margin="8,0,0,0"
                            Command="{Binding BrowseGameRootCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="MascotStrip" Grid.Row="2" Margin="16,10,16,0" Padding="7"
                Background="{StaticResource BgMidBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgDeepBrush}" CornerRadius="6" Margin="3" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Source="{StaticResource StickerPortrait}"
                               Width="68" Height="68" Stretch="Uniform" Margin="0,0,6,0"
                               AutomationProperties.Name="贴纸风格的呆猫画像" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="贴纸呆猫" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="老大，包给我瞅瞅？" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource BgDeepBrush}" CornerRadius="6" Margin="3" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Source="{StaticResource CrayonPortrait}"
                               Width="68" Height="68" Stretch="Uniform" Margin="0,0,6,0"
                               AutomationProperties.Name="蜡笔风格的呆猫画像" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="蜡笔呆猫" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="脑袋空空，路径看清。" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource BgDeepBrush}" CornerRadius="6" Margin="3" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Source="{StaticResource PixelPortrait}"
                               Width="68" Height="68" Stretch="Uniform" Margin="0,0,6,0"
                               AutomationProperties.Name="像素风格的呆猫画像" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="像素呆猫" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="老大，打勾我才搬！" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="3" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ModPane" Grid.Column="0" Margin="4,12,8,12"
                    Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,15,16,13"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="已导入 Mod" Style="{StaticResource HeaderText}" />
                                <TextBlock Text="{Binding Mods.Count, StringFormat={}{0} 个}"
                                           Style="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="勾选启用，取消勾选恢复原文件"
                                       Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Button Content="移除选中记录" Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Stretch" />
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Column="0" Grid.RowSpan="2" Margin="0,0,9,0"
                                                  VerticalAlignment="Center" ToolTip="勾选以启用或停用此 Mod"
                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding FilesSummary}"
                                                   Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                        <Border Grid.Column="2" Grid.Row="0" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                    <Setter Property="Background" Value="{StaticResource BgLightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessGreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="停用" />
                                                        <Setter Property="Foreground" Value="{StaticResource FgSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Text" Value="启用" />
                                                                <Setter Property="Foreground" Value="{StaticResource BgDeepBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Grid.Row="1" Text="前置" FontSize="11"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0"
                                                   Visibility="{Binding IsPrerequisite, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mods.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="尚无 Mod" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="老大，从右侧导入压缩包，再打勾启用。"
                                       Style="{StaticResource SecondaryText}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border x:Name="DetailPane" Grid.Column="1" Margin="8,12,4,12"
                    Style="{StaticResource Card}" Padding="0">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="导入与预览">
                        <Grid Margin="16,10,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="导入压缩包" Style="{StaticResource HeaderText}" />
                                    <TextBlock Text="ZIP、RAR、7Z 都可以；我先核对路径，再导入。"
                                               Style="{StaticResource SecondaryText}" Margin="0,4,0,14" />
                                    <TextBlock Text="压缩包" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ArchivePath, Mode=OneWay}" IsReadOnly="True"
                                                 ToolTip="{Binding ArchivePath}" />
                                        <Button Grid.Column="1" Content="选择压缩包" Margin="8,0,0,0"
                                                Command="{Binding BrowseArchiveCommand}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Background="{StaticResource BgDeepBrush}" CornerRadius="8"
                                            MinHeight="112" Margin="0,0,0,14" AllowDrop="True"
                                            Visibility="{Binding ArchivePath, Converter={StaticResource InvNotEmptyVis}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                            <TextBlock Text="↓" FontSize="29" FontWeight="Light"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="老大，也可以把压缩包拖到窗口" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            <TextBlock Text="导入前会显示版本、目标路径与冲突"
                                                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,13" Visibility="{Binding Analysis, Converter={StaticResource NotEmptyVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="安装版本 · 点选其中一个后才能导入" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                        <ListBox Grid.Row="1" ItemsSource="{Binding VariantNames}"
                                                 SelectedIndex="{Binding SelectedVariantIndex}"
                                                 MinHeight="40" MaxHeight="126"
                                                 Background="{StaticResource BgDeepBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                    </Grid>
                                    <Button Content="高级选项：手动映射" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10"
                                            Command="{Binding ToggleManualMappingCommand}" />
                                    <Grid Margin="0,0,0,14"
                                          Visibility="{Binding ShowManualMapping, Converter={StaticResource BoolVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="目标目录映射" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ManualMapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="仅当压缩包没有可识别目录时填写目标锚点" />
                                            <Button Grid.Column="1" Content="重新分析" Margin="8,0,0,0"
                                                    Command="{Binding AnalyzeCommand}" />
                                        </Grid>
                                    </Grid>
                                    <Border Style="{StaticResource Card}" Background="{StaticResource BgDeepBrush}"
                                            MinHeight="220" Margin="0,0,0,4"
                                            Visibility="{Binding PreviewText, Converter={StaticResource NotEmptyVis}}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <TextBlock Text="文件与风险预览" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="已有文件会备份；冲突需先处理。"
                                                           Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="154" VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                                     Background="Transparent" BorderThickness="0" Padding="0" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="导入所选版本  ·  默认停用"
                                    Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
                                    Margin="0,12,0,0" Padding="16,10" HorizontalAlignment="Stretch" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="前置环境">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <TextBlock Text="运行前置" Style="{StaticResource HeaderText}" />
                                <TextBlock Text="按当前游戏所需组件检查；复制完成后仍需进游戏确认生效。"
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,16" />
                                <ItemsControl ItemsSource="{Binding Prerequisites_}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="●" FontSize="14" Margin="0,1,12,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnYellowBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}"
                                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        <Button Content="{Binding ButtonText}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolVis}}"
                                                                Command="{Binding DataContext.ConfigurePrerequisiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="操作记录">
                        <Grid Margin="16,10,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="操作记录" Style="{StaticResource HeaderText}" />
                                <TextBlock Text="当前会话的分析、导入与启停消息"
                                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource BgDeepBrush}">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" ToolTip="保留本次运行最近 200 条操作记录" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                         Background="Transparent" BorderThickness="0" Padding="0" />
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="●" Foreground="{StaticResource SuccessGreenBrush}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="5" Background="#B8141D22"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="24,18">
                <TextBlock Text="正在处理，请稍候…" FontSize="15" FontWeight="SemiBold" />
            </Border>
        </Border>
    </Grid>
</Window>
